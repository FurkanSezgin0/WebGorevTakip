@{
    ViewData["Title"] = "Merhaba, Furkan 👋";
}


<div class="row mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body d-flex align-items-center p-4">
                <div class="bg-primary text-white rounded p-3 me-3 d-flex justify-content-center align-items-center" style="width:50px; height:50px;">
                    <h5 class="mb-0">📋</h5>
                </div>
                <div>
                    <h3 class="mb-0 fw-bold">@ViewBag.ToplamGorev</h3>
                    <span class="text-muted small fw-bold">Toplam Görev</span>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body d-flex align-items-center p-4">
                <div class="bg-warning text-dark rounded p-3 me-3 d-flex justify-content-center align-items-center" style="width:50px; height:50px;">
                    <h5 class="mb-0">📈</h5>
                </div>
                <div>
                    <h3 class="mb-0 fw-bold">@ViewBag.AcikGorev</h3>
                    <span class="text-muted small fw-bold">Açık Görevler</span>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body d-flex align-items-center p-4">
                <div class="bg-success text-white rounded p-3 me-3 d-flex justify-content-center align-items-center" style="width:50px; height:50px;">
                    <h5 class="mb-0">✅</h5>
                </div>
                <div>
                    <h3 class="mb-0 fw-bold">@(ViewBag.ToplamGorev - ViewBag.AcikGorev)</h3>
                    <span class="text-muted small fw-bold">Tamamlanan</span>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body d-flex align-items-center p-4">
                <div class="bg-info text-white rounded p-3 me-3 d-flex justify-content-center align-items-center" style="width:50px; height:50px;">
                    <h5 class="mb-0">⏱️</h5>
                </div>
                <div>
                    <h3 class="mb-0 fw-bold">@ViewBag.ToplamEfor</h3>
                    <span class="text-muted small fw-bold">Bu Ay Efor (saat)</span>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="row">
   
    <div class="col-md-6 mb-4">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h6 class="fw-bold text-muted mb-0">Durum Dağılımı</h6>
            </div>
            <div class="card-body d-flex justify-content-center" style="min-height: 300px;">
                <canvas id="durumGrafigi"></canvas>
            </div>
        </div>
    </div>
    
   
    <div class="col-md-6 mb-4">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h6 class="fw-bold text-muted mb-0">Öncelik Dağılımı</h6>
            </div>
            <div class="card-body" style="min-height: 300px;">
                <canvas id="oncelikGrafigi"></canvas>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var durumVerisi = @Html.Raw(Json.Serialize(ViewBag.DurumData));
        var oncelikVerisi = @Html.Raw(Json.Serialize(ViewBag.OncelikData));

        new Chart(document.getElementById('durumGrafigi').getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: ['Backlog', 'Bekliyor', 'Devam Ediyor', 'Tamamlandı'],
                datasets: [{ data: durumVerisi, backgroundColor: ['#94a3b8', '#3b82f6', '#f59e0b', '#10b981'], borderWidth: 0 }]
            },
            options: { responsive: true, maintainAspectRatio: false, cutout: '70%' }
        });

        new Chart(document.getElementById('oncelikGrafigi').getContext('2d'), {
            type: 'bar',
            data: {
                labels: ['Kritik', 'Yüksek', 'Orta', 'Düşük'],
                datasets: [{ label: 'Görevler', data: oncelikVerisi, backgroundColor: '#8b5cf6', borderRadius: 4 }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
        });
    </script>
}