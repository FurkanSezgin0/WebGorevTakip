@model List<anbanBoardApp.Models.Proje>
@{
    ViewData["Title"] = "Projeler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="text-muted small">
        Sistemde kayıtlı @Model.Count proje bulunuyor.
    </div>
    <button class="btn btn-primary btn-sm fw-bold px-4" data-bs-toggle="modal" data-bs-target="#yeniProjeModal">
        + Yeni Proje Oluştur
    </button>
</div>

<div class="row">
    @foreach (var proje in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 border-0 shadow-sm" style="border-radius: 12px; transition: transform 0.2s;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="badge bg-light text-primary border rounded-pill px-3 py-2">@proje.Durum</span>
                        <form action="/Projeler/Sil" method="post" onsubmit="return confirm('Bu projeyi tamamen silmek istediğinize emin misiniz?');">
                            <input type="hidden" name="id" value="@proje.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger border-0 p-1">🗑️</button>
                        </form>
                    </div>
                    <h5 class="card-title fw-bold text-dark mb-2">@proje.Ad</h5>
                    <p class="card-text text-muted small" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                        @proje.Aciklama
                    </p>
                </div>
                <div class="card-footer bg-white border-top p-3 d-flex justify-content-between align-items-center" style="border-radius: 0 0 12px 12px;">
                    <small class="text-muted fw-bold">
                        📅 @proje.BaslangicTarihi.ToString("dd MMM yyyy")
                    </small>
                    <a href="/Board/Index?projeId=@proje.Id" class="btn btn-sm btn-light border-0 fw-bold text-primary">Panoya Git ➔</a>
                </div>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="yeniProjeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content shadow border-0" style="border-radius: 12px;">
            <form action="/Projeler/Ekle" method="post">
                <div class="modal-header bg-light border-bottom-0" style="border-radius: 12px 12px 0 0;">
                    <h5 class="modal-title fw-bold">📁 Yeni Proje Başlat</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Proje Adı</label>
                        <input type="text" name="Ad" class="form-control" placeholder="Örn: E-Ticaret Yenileme" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Açıklama / Hedef</label>
                        <textarea name="Aciklama" class="form-control" rows="3" placeholder="Projenin temel amacı nedir?"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold text-success">Başlangıç Tarihi</label>
                            <input type="date" name="BaslangicTarihi" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold text-danger">Bitiş Tarihi (Opsiyonel)</label>
                            <input type="date" name="BitisTarihi" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 bg-light" style="border-radius: 0 0 12px 12px;">
                    <button type="submit" class="btn btn-primary px-4 fw-bold">Projeyi Oluştur</button>
                </div>
            </form>
        </div>
    </div>
</div>