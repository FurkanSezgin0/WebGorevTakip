                                {
                                    <option value="@s.KodAdi">@s.Ad</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold text-danger">Öncelik</label>
                            <select name="Oncelik" id="duzenleOncelik" class="form-select bg-light">
                                <option value="Kritik">Kritik</option>
                                <option value="Yüksek">Yüksek</option>
                                <option value="Orta">Orta</option>
                                <option value="Düşük">Düşük</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold text-warning">Süre (Saat)</label>
                            <input type="number" step="0.5" min="0" name="TahminiSure" id="duzenleSure" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Teslim Tarihi</label>
                            <input type="datetime-local" name="TeslimTarihi" id="duzenleTeslim" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-success">Personeller</label>
                            <select name="AtananKullaniciIdleri" id="duzenleAtanan" class="form-select" multiple size="3">
                                @if (kullaniciListesi != null)
                                {
                                    foreach (var k in kullaniciListesi)
                                    {
                                        <option value="@k.Value">@k.Text</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 bg-light">
                    <button type="submit" class="btn btn-warning px-4 fw-bold">Değişiklikleri Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>


<div class="modal fade" id="gorevDetayModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content shadow border-0" style="border-radius:12px;">
            <div class="modal-header bg-light border-bottom-0">
                <h5 class="modal-title fw-bold" id="detayBaslik">Görev Yükleniyor...</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted" id="detayAciklama"></p>
                <div class="d-flex gap-2 mb-3">
                    <span class="badge bg-light text-primary border" id="detayProje"></span>
                    <span class="badge bg-light text-secondary border" id="detaySprint"></span>
                </div>
                <div class="d-flex gap-3 mb-4 border-bottom pb-3">
                    <span class="badge bg-primary px-3 py-2" id="detayDurum"></span>
                    <span class="badge bg-danger px-3 py-2" id="detayOncelik"></span>
                </div>
                <h6 class="fw-bold mb-3">💬 Yorumlar</h6>
                <div id="yorumListesi" class="mb-3" style="max-height: 250px; overflow-y: auto; background:#f8fafc; border-radius:8px; padding:15px;"></div>
                <div class="input-group">
                    <input type="hidden" id="yorumGorevId" />
                    <input type="text" id="yeniYorumMetni" class="form-control" placeholder="Bir yorum yazın..." />
                    <button class="btn btn-primary fw-bold px-4" onclick="yorumYap()">Gönder</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="sutunModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light border-bottom-0"><h5 class="modal-title fw-bold">⚙️ Sütunları Düzenle</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body p-4">
                <ul class="list-group mb-4 shadow-sm" id="sutunListesi">
                    @foreach (var sutun in ViewBag.Sutunlar as List<anbanBoardApp.Models.Sutun>)
                    {
                        string lockedClass = sutun.KilitliMi ? "locked" : "";
                        <li class="list-group-item d-flex justify-content-between align-items-center sutun-item @lockedClass" data-id="@sutun.KodAdi">
                            <div class="d-flex align-items-center gap-2"><span class="drag-handle" title="Sürükle">↕️</span><span class="fw-bold" style="color:@sutun.Renk;">● @sutun.Ad</span></div>
                            <div><button class="btn btn-sm border-0 fs-5 text-dark" onclick="kilitDegistir(this)">@(sutun.KilitliMi ? "🔒" : "🔓")</button><button class="btn btn-sm btn-outline-danger border-0 delete-btn" onclick="sutunSil(this)" @(sutun.KilitliMi ? "disabled" : "")>🗑️</button></div>
                        </li>
                    }
                </ul>
                <h6 class="fw-bold mb-3">Yeni Sütun Ekle</h6>
                <div class="input-group">
                    <input type="text" id="yeniSutunAdi" class="form-control" placeholder="Sütun Adı">
                    <input type="color" id="yeniSutunRengi" class="form-control form-control-color" value="#8b5cf6">
                    <button class="btn btn-primary px-4 fw-bold" onclick="yeniSutunEkle()">Ekle</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script>
        
        function sprintFiltrele(prefix) {
            let projeId = document.getElementById(prefix + 'ProjeSelect').value;
            let sprintSelect = document.getElementById(prefix + 'SprintSelect');
            let options = sprintSelect.options;

            for(let i=1; i < options.length; i++) { 
                if (options[i].getAttribute('data-projeid') === projeId) {
                    options[i].style.display = 'block';
                } else {
                    options[i].style.display = 'none';
                }
            }
            sprintSelect.value = ""; 
        }

        function gorevTamamla(evt, id) {
            evt.stopPropagation();
            if(confirm('Görevi tamamlandı olarak işaretlemek istiyor musunuz?')) {
                fetch('/Board/DurumGuncelle', { method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body:`gorevId=${id}&yeniDurum=Tamamlandi`})
                .then(() => location.reload());
            }
        }

        function sutunaSortableEkle(sutunId) {
            let el = document.getElementById(sutunId);
            if(el) {
                let isTamamlandi = (sutunId === 'Tamamlandi');
                new Sortable(el, {
                    group: { name: 'kanban', put: true, pull: !isTamamlandi },
                    animation: 150, draggable: '.kanban-card', filter: '.btn',
                    onEnd: evt => {
                        if(evt.from.id !== evt.to.id) {
                            fetch('/Board/DurumGuncelle', { method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body:`gorevId=${evt.item.getAttribute('data-id')}&yeniDurum=${evt.to.id}`})
                            .then(() => location.reload());
                        }
                    }
                });
            }
        }
        @foreach (var s in ViewBag.Sutunlar)
        {
            <text>sutunaSortableEkle('@s.KodAdi');</text>
        }

        function duzenleModalAc(btn) {
            document.getElementById('duzenleId').value = btn.getAttribute('data-id');
            document.getElementById('duzenleBaslik').value = btn.getAttribute('data-baslik');
            document.getElementById('duzenleAciklama').value = btn.getAttribute('data-aciklama');
            document.getElementById('duzenleDurum').value = btn.getAttribute('data-durum');
            document.getElementById('duzenleOncelik').value = btn.getAttribute('data-oncelik');
            document.getElementById('duzenleSure').value = btn.getAttribute('data-sure');
            document.getElementById('duzenleTeslim').value = btn.getAttribute('data-teslim') || "";

            
            let pId = btn.getAttribute('data-projeid');
            let sId = btn.getAttribute('data-sprintid');
            document.getElementById('duzenleProjeSelect').value = pId || "";
            sprintFiltrele('duzenle'); 
            document.getElementById('duzenleSprintSelect').value = sId || "";

            let atananlar = btn.getAttribute('data-atanan').split(',');
            let selectBox = document.getElementById('duzenleAtanan');
            for(let i=0; i<selectBox.options.length; i++) selectBox.options[i].selected = atananlar.includes(selectBox.options[i].value);

            new bootstrap.Modal(document.getElementById('duzenleGorevModal')).show();
        }

        function gorevDetayAc(id) {
            fetch('/Board/GorevDetay?id=' + id).then(r => r.json()).then(data => {
                document.getElementById('detayBaslik').innerText = data.baslik;
                document.getElementById('detayAciklama').innerText = data.aciklama || "Açıklama girilmemiş.";
                document.getElementById('detayDurum').innerText = data.durum;
                document.getElementById('detayOncelik').innerText = "Öncelik: " + data.oncelik;
                document.getElementById('detayProje').innerText = "📁 " + data.proje;
                document.getElementById('detaySprint').innerText = "🏃 " + data.sprint;
                document.getElementById('yorumGorevId').value = data.id;

                let html = '';
                if (data.yorumlar.length === 0) html = "<div class='text-muted small'>Henüz yorum yapılmamış.</div>";
                else data.yorumlar.forEach(y => html += `<div class="mb-2 p-2 bg-white border shadow-sm rounded"><div class="d-flex justify-content-between"><strong class="small text-primary">${y.kisi}</strong><small class="text-muted">${y.tarih}</small></div><div class="small mt-1">${y.metin}</div></div>`);
                document.getElementById('yorumListesi').innerHTML = html;
                new bootstrap.Modal(document.getElementById('gorevDetayModal')).show();
            });
        }

        function yorumYap() {
            let metin = document.getElementById('yeniYorumMetni').value;
            let gorevId = document.getElementById('yorumGorevId').value;
            if(!metin.trim()) return;
            fetch('/Board/YorumEkleAjax', { method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body:`gorevId=${gorevId}&yorumMetni=${encodeURIComponent(metin)}`})
            .then(() => { document.getElementById('yeniYorumMetni').value = ''; gorevDetayAc(gorevId); });
        }

        // Modal Diğer Fonksiyonlar (Kilit, Sil, Yeni Sütun)
        function kilitDegistir(btn) {
            let satir = btn.closest('.sutun-item'); let isLocked = satir.classList.contains('locked'); let deleteBtn = satir.querySelector('.delete-btn');
            if (isLocked) { satir.classList.remove('locked'); btn.innerText = '🔓'; deleteBtn.disabled = false; }
            else { satir.classList.add('locked'); btn.innerText = '🔒'; deleteBtn.disabled = true; }
        }
        new Sortable(document.getElementById('sutunListesi'), {
            handle: '.drag-handle', animation: 150, filter: '.locked',
            onMove: function (evt) { return evt.related.className.indexOf('locked') === -1; },
            onEnd: function () {
                let container = document.querySelector('.kanban-container');
                document.querySelectorAll('#sutunListesi .sutun-item').forEach(item => {
                    let col = document.getElementById(item.getAttribute('data-id')); if(col) container.appendChild(col);
                });
            }
        });
        function sutunSil(btn) {
            if(confirm('Emin misiniz?')) {
                let li = btn.closest('.sutun-item'); let id = li.getAttribute('data-id');
                li.remove(); let col = document.getElementById(id); if(col) col.remove();
                let opt = document.querySelector(`#yeniGorevDurumSelect option[value="${id}"]`); if(opt) opt.remove();
            }
        }
        function yeniSutunEkle() {
            let ad = document.getElementById('yeniSutunAdi').value.trim(); let renk = document.getElementById('yeniSutunRengi').value;
            if(!ad) return; let kodAdi = ad.replace(/\s+/g, '');
            let li = document.createElement('li'); li.className = 'list-group-item d-flex justify-content-between align-items-center sutun-item'; li.setAttribute('data-id', kodAdi);
            li.innerHTML = `<div class="d-flex align-items-center gap-2"><span class="drag-handle">↕️</span><span class="fw-bold" style="color:${renk}">● ${ad}</span></div><div><button class="btn btn-sm border-0 fs-5 text-dark" onclick="kilitDegistir(this)">🔓</button><button class="btn btn-sm btn-outline-danger border-0 delete-btn" onclick="sutunSil(this)">🗑️</button></div>`;
            document.getElementById('sutunListesi').appendChild(li);
            let col = document.createElement('div'); col.className = 'kanban-column'; col.id = kodAdi; col.style.borderTop = `4px solid ${renk}`;
            col.innerHTML = `<div class="col-title"><span><span style="color:${renk};">●</span> ${ad}</span> <span class="badge bg-light text-dark border rounded-pill">0</span></div>`;
            document.querySelector('.kanban-container').appendChild(col);
            sutunaSortableEkle(kodAdi);
            let opt = document.createElement('option'); opt.value = kodAdi; opt.text = ad; document.getElementById('yeniGorevDurumSelect').appendChild(opt);
            document.getElementById('yeniSutunAdi').value = '';
        }
    </script>
}