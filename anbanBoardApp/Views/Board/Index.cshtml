                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-primary">📁 Bağlı Proje</label>
                            <select name="ProjeId" id="duzenleProjeSelect" class="form-select bg-light" onchange="sprintFiltrele('duzenle')">
                                <option value="">-- Projeden Bağımsız --</option>
                                @if (projeListesi != null)
                                {
                                    foreach (var p in projeListesi)
                                    {
                                        <option value="@p.Value">@p.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary">🏃 Sprint (Koşu)</label>
                            <select name="SprintId" id="duzenleSprintSelect" class="form-select bg-light">
                                <option value="">-- Önce Proje Seçin --</option>
                                @if (sprintListesi != null)
                                {
                                    foreach (var s in sprintListesi)
                                    {
                                        <option value="@s.Id" data-projeid="@s.ProjeId" style="display:none;">@s.Ad</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">Sütun (Durum)</label>
                            <select name="Durum" id="duzenleDurum" class="form-select bg-light">
