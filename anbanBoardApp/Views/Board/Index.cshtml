                            <input type="text" name="Baslik" id="duzenleBaslik" class="form-control" required />
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold">Açıklama</label>
                            <textarea name="Aciklama" id="duzenleAciklama" class="form-control" rows="2"></textarea>
